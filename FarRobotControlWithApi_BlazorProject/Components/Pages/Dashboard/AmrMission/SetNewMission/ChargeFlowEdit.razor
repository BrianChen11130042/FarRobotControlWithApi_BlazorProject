@using FarRobotControlWithApi_BlazorProject.EFModel
<DxFormLayout>
    <DxFormLayoutItem Caption="CellName" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="12">
        <DxTextBox @bind-Text="Flow.CellName" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="Percentage" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="12">
        <DxSpinEdit @bind-Value="Flow.Percentage" MinValue="0" MaxValue="100" />
    </DxFormLayoutItem>
</DxFormLayout>

@code {
    [Parameter, EditorRequired]
    public ChargeFlowTable Flow { get; set; } = null!;
}
