@using FarRobotControlWithApi_BlazorProject.Components.Pages.Dashboard.AmrMission
@using FarRobotControlWithApi_BlazorProject.Components.Pages.Dashboard.AmrMission.EditFlow
@using FarRobotControlWithApi_BlazorProject.Components.Pages.Dashboard.AmrMission.PrintFlow
@using FarRobotControlWithApi_BlazorProject.EFModel

<DxPopup @ref="popup" HeaderText="New Mission" ShowCloseButton="true" CloseOnOutsideClick="false" Width="50rem">
    <BodyContentTemplate Context="PopupContext">

        <DxFormLayout>
            <DxFormLayoutItem Caption="AMR Serial Number" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="8">
                <DxComboBox Data="@ListAmrSerialNumber" @bind-Value="missionTable.AmrSerialNumber" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Priority" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="8">
                <DxSpinEdit @bind-Value="missionTable.Priority" MinValue="1" MaxValue="5" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Flow" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="6">
                <DxComboBox Data="@ListFlowType" @bind-Value="editFlowType" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="2">
                <DxButton Text="+Flow" Click="_clickAddFlow" RenderStyle="ButtonRenderStyle.Secondary" />
            </DxFormLayoutItem>
        </DxFormLayout>

        @if (editFlow is not null)
        {
            <div class="border rounded p-2 mb-2" style="margin-top:12px;">
                <EditFlowHost Flow="editFlow" ListCellName="ListCellName" />
                <div class="mt-3">
                    <DxButton Text="OK" Click="_clickConfirmEditFlow" RenderStyle="ButtonRenderStyle.Primary" />
                    <DxButton Text="Cancel" Click="_clickCancelEditFlow" />
                </div>
            </div>
        }

        @for (int i = 0; i < listFlow.Count; i++)
        {
            var index = i;
            var flow = listFlow[index];

            <div class="d-flex align-items-center gap-2 mb-2 border p-2" style="margin-top:12px;">
                <span style="width:2rem;">@(index + 1)</span>
                <span style="width:5rem;">@_getFlowType(flow)</span>
                <span class="flex-grow-1">
                    <PrintFlowHost Flow="flow" />
                </span>
                <DxButton Text="Delete" Click="@(() => _removeFlow(index))" RenderStyle="ButtonRenderStyle.Danger" />
            </div>
        }

        <div class="mt-3 text-end">
            <DxButton Text="Save" Click="SaveAsync" RenderStyle="ButtonRenderStyle.Primary" />
            <DxButton Text="Close" Click="CloseAsync" />
        </div>

    </BodyContentTemplate>
</DxPopup>

@code {
    DxPopup? popup { get; set; } = null;

    [Parameter]
    public EventCallback<AmrMissionTable> CbOnSaved { get; set; }

    [Parameter, EditorRequired]
    public List<EFlowType> ListFlowType { get; set; } = new List<EFlowType>();

    [Parameter, EditorRequired]
    public List<string> ListAmrSerialNumber { get; set; } = new List<string>();

    [Parameter, EditorRequired]
    public List<string> ListCellName { get; set; } = new List<string>();

    AmrMissionTable missionTable { get; set; } = new AmrMissionTable();

    bool isEditFlow { get; set; } = false;
    EFlowType editFlowType { get; set; } = EFlowType.Move;
    FlowBase? editFlow { get; set; } = null;
    List<FlowBase> listFlow { get; set; } = new List<FlowBase>();

    public async Task ShowAsync()
    {
        missionTable = new AmrMissionTable
        {
            AmrSerialNumber = ListAmrSerialNumber.FirstOrDefault() ?? "",
            Priority = 3
        };

        listFlow.Clear();
        editFlow = null;
        isEditFlow = false;
        await popup.ShowAsync();
    }

    void _clickAddFlow()
    {
        isEditFlow = true;
        editFlow = _getFlowTable(editFlowType);
    }

    FlowBase _getFlowTable(EFlowType type)
    {
        switch (type)
        {
            case EFlowType.Move:
                return new MoveFlowTable();

            case EFlowType.Charge:
                return new ChargeFlowTable() { Percentage = 100 };

            default:
                return null;
        }
    }

    void _clickConfirmEditFlow()
    {
        if (editFlow != null && isEditFlow)
        {
            listFlow.Add(editFlow);
        }

        editFlow = null;
        isEditFlow = false;
    }

    void _clickCancelEditFlow()
    {
        editFlow = null;
        isEditFlow = false;
    }

    string _getFlowType(FlowBase flow)
    {
        switch (flow)
        {
            case MoveFlowTable move:
                return EFlowType.Move.ToString();

            case ChargeFlowTable charge:
                return EFlowType.Charge.ToString();

            default:
                return "?";
        }
    }

    void _removeFlow(int index)
    {
        listFlow.RemoveAt(index);
    }

    async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(missionTable.AmrSerialNumber))
            return;

        if (listFlow.Count == 0)
            return;

        var now = DateTime.Now;
        missionTable.Id = Guid.NewGuid();
        missionTable.EstablishTime = now;
        missionTable.FlowCount = listFlow.Count;

        for (int i = 0; i < listFlow.Count; i++)
        {
            var f = listFlow[i];
            f.Id = Guid.NewGuid();
            f.MissionId = missionTable.Id;
            f.AmrSerialNumber = missionTable.AmrSerialNumber;
            f.Priority = missionTable.Priority;
            f.EstablishTime = now.AddSeconds(i);
        }

        missionTable.Flows = listFlow.ToList();
        await CbOnSaved.InvokeAsync(missionTable);
        await CloseAsync();
    }

    async Task CloseAsync()
    {
        await popup!.CloseAsync();
    }
}
