@using FarRobotControlWithApi_BlazorProject.EFModel

<DxPopup @ref="popup" HeaderText="New Mission" ShowCloseButton="true" CloseOnOutsideClick="false" Width="50rem">
    <BodyContentTemplate Context="popupContext">

        <DxFormLayout>

            <DxFormLayoutItem Caption="AMR Serial Number" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="8">
                <DxComboBox Data="@listAmrSerialNumber" @bind-Value="missionTable.AmrSerialNumber" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Priority" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="8">
                <DxSpinEdit @bind-Value="missionTable.Priority" MinValue="1" MaxValue="5" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Flow" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="6">
                <DxComboBox Data="@listFlowType" @bind-Value="editFlowType" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="2">
                <DxButton Text="+Flow" Click="BeginAddFlow" RenderStyle="ButtonRenderStyle.Secondary" />
            </DxFormLayoutItem>

        </DxFormLayout>

        @if (editFlow is not null)
        {
            <div class="border p-2 mb-2" style="margin-top:12px;">
                <FlowEditHost Flow="editFlow" />
                <div class="mt-3">
                    <DxButton Text="OK" Click="ConfirmEditFlow" RenderStyle="ButtonRenderStyle.Primary" />
                    <DxButton Text="Cancel" Click="CancelEditFlow" />
                </div>
            </div>
        }

        @for (int i = 0; i < listFlow.Count; i++)
        {
            var index = i;
            var flow = listFlow[index];
            <div class="d-flex align-items-center gap-2 mb-2 border p-2" style="margin-top:12px;">
                <span style="width:2rem;">@(index + 1)</span>
                <span style="width:5rem;">@_flowTypeName(flow)</span>
                <span class="flex-grow-1">@_flowSummary(flow)</span>
                <DxButton Text="Delete" Click="@(() => RemoveFlow(index))" RenderStyle="ButtonRenderStyle.Danger" />
            </div>
        }

        <div class="mt-3 text-end">
            <DxButton Text="Save" Click="SaveAsync" RenderStyle="ButtonRenderStyle.Primary" />
            <DxButton Text="Close" Click="CloseAsync" />
        </div>

    </BodyContentTemplate>
</DxPopup>

@code {

    public enum EFlowType
    {
        Move,
        Charge
    }

    List<EFlowType> listFlowType { get; set; } = new List<EFlowType>()
    {
        EFlowType.Move,
        EFlowType.Charge
    };

    List<string> listAmrSerialNumber { get; set; } = new List<string>()
    {
        "smr_9901010401002t73j251"
    };

    [Parameter]
    public EventCallback<AmrMissionTable> OnSaved { get; set; }

    DxPopup? popup { get; set; }
    AmrMissionTable missionTable { get; set; } = new AmrMissionTable();
    List<FlowBase> listFlow { get; set; } = new List<FlowBase>();

    EFlowType editFlowType { get; set; } = EFlowType.Move;
    FlowBase? editFlow { get; set; }
    bool isNewEdit;

    public async Task ShowAsync()
    {
        missionTable = new AmrMissionTable
        {
            AmrSerialNumber = listAmrSerialNumber.FirstOrDefault() ?? "",
            Priority = 3
        };

        listFlow = new List<FlowBase>();
        editFlow = null;
        await popup?.ShowAsync();
    }

    void BeginAddFlow()
    {
        isNewEdit = true;

        editFlow = _getFlowTable(editFlowType);
    }

    FlowBase _getFlowTable(EFlowType type)
    {
        switch (type)
        {
            case EFlowType.Move:
                return new MoveFlowTable();

            case EFlowType.Charge:
                return new ChargeFlowTable() { Percentage = 100 };

            default:
                return null;
        }
    }

    void ConfirmEditFlow()
    {
        if (editFlow is null) return;
        if (isNewEdit)
            listFlow.Add(editFlow);
        editFlow = null;
        isNewEdit = false;
    }

    void CancelEditFlow()
    {
        editFlow = null;
        isNewEdit = false;
    }

    void RemoveFlow(int index)
    {
        listFlow.RemoveAt(index);
    }

    string _flowTypeName(FlowBase flow) => flow switch
    {
        MoveFlowTable => "Move",
        ChargeFlowTable => "Charge",
        _ => "?"
    };

    string _flowSummary(FlowBase flow) => flow switch
    {
        MoveFlowTable m => m.CellName ?? "",
        ChargeFlowTable c => $"{c.CellName} / {c.Percentage}%",
        _ => ""
    };

    async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(missionTable.AmrSerialNumber))
            return;

        if (listFlow.Count == 0)
            return;

        var now = DateTime.Now;
        missionTable.Id = Guid.NewGuid();
        missionTable.EstablishTime = now;
        missionTable.FlowCount = listFlow.Count;

        for (int i = 0; i < listFlow.Count; i++)
        {
            var f = listFlow[i];
            f.Id = Guid.NewGuid();
            f.MissionId = missionTable.Id;
            f.AmrSerialNumber = missionTable.AmrSerialNumber;
            f.Priority = missionTable.Priority;
            f.EstablishTime = now.AddSeconds(i);
        }

        missionTable.Flows = listFlow.ToList();
        await OnSaved.InvokeAsync(missionTable);
        await CloseAsync();
    }

    async Task CloseAsync()
    {
        await popup!.CloseAsync();
    }
}
