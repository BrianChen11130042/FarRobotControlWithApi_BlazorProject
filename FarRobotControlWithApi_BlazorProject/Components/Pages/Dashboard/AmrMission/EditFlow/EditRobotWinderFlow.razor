@using FarRobotControlWithApi_BlazorProject.DTOModel
@using FarRobotControlWithApi_BlazorProject.EFModel

<DxFormLayout>
    <DxFormLayoutItem Caption="Cell Name" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="12">
        <DxComboBox Data="@ListCellName" @bind-Value="Flow.CellName" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="Winder Unlock ArtifactId" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="12">
        <DxComboBox Data="@ListExtArtifactId" @bind-Value="Flow.WinderUnlockArtifactId" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="Unlock Finish Param" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="6">
        <DxSpinEdit @bind-Value="Flow.WinderUnlockFinishParam" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="Unlock Error Param" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="6">
        <DxSpinEdit @bind-Value="Flow.WinderUnlockErrorParam" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="TM Robot ArtifactId" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="12">
        <DxComboBox Data="@ListEmbArtifactId" @bind-Value="Flow.TmRobotArtifactId" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="TM Start Param" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
        <DxSpinEdit @bind-Value="Flow.TmRobotStartParam" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="TM Finish Param" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
        <DxSpinEdit @bind-Value="Flow.TmRobotFinishParam" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="TM Error Param" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
        <DxSpinEdit @bind-Value="Flow.TmRobotErrorParam" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="Winder Lock ArtifactId" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="12">
        <DxComboBox Data="@ListExtArtifactId" @bind-Value="Flow.WinderLockArtifactId" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="Lock Finish Param" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="6">
        <DxSpinEdit @bind-Value="Flow.WinderLockFinishParam" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="Lock Error Param" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="6">
        <DxSpinEdit @bind-Value="Flow.WinderLockErrorParam" />
    </DxFormLayoutItem>
</DxFormLayout>

@code {
    [Parameter, EditorRequired]
    public RobotWinderFlowTable Flow { get; set; } = null!;

    [Parameter, EditorRequired]
    public List<string> ListCellName { get; set; } = new List<string>();

    [Parameter, EditorRequired]
    public List<ArtifactInformDto> ListEmbArtifact { get; set; } = new List<ArtifactInformDto>();

    [Parameter, EditorRequired]
    public List<ArtifactInformDto> ListExtArtifact { get; set; } = new List<ArtifactInformDto>();

    List<string> ListEmbArtifactId => ListEmbArtifact
        .Where(x => string.Equals(x.Type, "emb_UD", StringComparison.OrdinalIgnoreCase))
        .Select(x => x.Id)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList();

    List<string> ListExtArtifactId => ListExtArtifact
        .Where(x => string.Equals(x.Type, "ext_UD", StringComparison.OrdinalIgnoreCase))
        .Select(x => x.Id)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList();

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Flow.CellName) && ListCellName.Count > 0)
            Flow.CellName = ListCellName[0];

        if (ListExtArtifactId.Count > 0)
            Flow.WinderUnlockArtifactId = ListExtArtifactId[0];

        if (ListEmbArtifactId.Count > 0)
            Flow.TmRobotArtifactId = ListEmbArtifactId[0];

        if (ListExtArtifactId.Count > 0)
            Flow.WinderLockArtifactId = ListExtArtifactId[0];
    }
}
