@using FarRobotControlWithApi_BlazorProject.DTOModel
@using FarRobotControlWithApi_BlazorProject.EFModel
@switch (Flow)
{
    case MoveFlowTable move:
        <EditMoveFlow Flow="move" ListCellName="ListCellName" />
        break;
    case ChargeFlowTable charge:
        <EditChargeFlow Flow="charge" ListCellName="ListCellName" />
        break;

    case MoveArtifactFlowTable moveArtifact:
        <EditMoveArtifactFlow Flow="moveArtifact" ListCellName="ListCellName" ListEmbArtifact="ListEmbArtifact" />
        break;

    case MoveArtifactsFlowTable moveArtifacts:
        <EditMoveArtifactsFlow Flow="moveArtifacts" ListCellName="ListCellName" ListEmbArtifact="ListEmbArtifact" ListExtArtifact="ListExtArtifact" />
        break;

    default:
        break;
}

@code {
    [Parameter]
    public FlowBase? Flow { get; set; }

    [Parameter, EditorRequired]
    public List<string> ListCellName { get; set; } = new List<string>();

    [Parameter, EditorRequired]
    public List<ArtifactInformDto> ListEmbArtifact { get; set; } = new List<ArtifactInformDto>();

    [Parameter, EditorRequired]
    public List<ArtifactInformDto> ListExtArtifact { get; set; } = new List<ArtifactInformDto>();
}
