@using FarRobotControlWithApi_BlazorProject.EFModel
@switch (Flow)
{
    case MoveFlowTable move:
        <EditMoveFlow Flow="move" ListCellName="ListCellName" />
        break;
    case ChargeFlowTable charge:
        <EditChargeFlow Flow="charge" ListCellName="ListCellName" />
        break;

    default:
        break;
}

@code {
    [Parameter]
    public FlowBase? Flow { get; set; }

    [Parameter, EditorRequired]
    public List<string> ListCellName { get; set; } = new List<string>();
}
