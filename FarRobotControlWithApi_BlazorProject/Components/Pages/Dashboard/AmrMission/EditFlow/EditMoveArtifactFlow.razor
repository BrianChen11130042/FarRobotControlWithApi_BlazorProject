@using FarRobotControlWithApi_BlazorProject.DTOModel
@using FarRobotControlWithApi_BlazorProject.EFModel

<DxFormLayout>
    <DxFormLayoutItem Caption="Cell Name" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="12">
        <DxComboBox Data="@ListCellName" @bind-Value="Flow.CellName" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="Emb Artifact Id" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="12">
        <DxComboBox Data="@ListEmbArtifactId" @bind-Value="Flow.EmbArtifactId" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="Start Param" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
        <DxSpinEdit @bind-Value="Flow.StartParam" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="Finish Param" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
        <DxSpinEdit @bind-Value="Flow.FinishParam" />
    </DxFormLayoutItem>

    <DxFormLayoutItem Caption="Error Param" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
        <DxSpinEdit @bind-Value="Flow.ErrorParam" />
    </DxFormLayoutItem>
</DxFormLayout>


@code {

    [Parameter, EditorRequired]
    public MoveArtifactFlowTable Flow { get; set; } = null!;

    [Parameter, EditorRequired]
    public List<string> ListCellName { get; set; } = new List<string>();

    [Parameter, EditorRequired]
    public List<ArtifactInformDto> ListEmbArtifact { get; set; } = new List<ArtifactInformDto>();

    List<string> ListEmbArtifactId => ListEmbArtifact.Where(x => string.Equals(x.Type, "emb_UD", StringComparison.OrdinalIgnoreCase))
                                                     .Select(x => x.Id)
                                                     .Where(x => !string.IsNullOrWhiteSpace(x))
                                                     .Distinct()
                                                     .ToList();

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Flow.CellName) && ListCellName.Count > 0)
        {
            Flow.CellName = ListCellName[0];
        }

        if (ListEmbArtifactId.Count > 0)
        {
            Flow.EmbArtifactId = ListEmbArtifactId[0];
        }
    }

}
