@using FarRobotControlWithApi_BlazorProject.Components.Pages.Dashboard.AmrMission.MissionDetail
@using FarRobotControlWithApi_BlazorProject.Components.Pages.Dashboard.AmrMission.SetNewMission
@using FarRobotControlWithApi_BlazorProject.EFModel
@using FarRobotControlWithApi_BlazorProject.Services.Interface
@using FarRobotControlWithApi_BlazorProject.UITools.ToastMessage
@rendermode RenderMode.InteractiveServer
@inject IMachineService machineService
@inject IToastMessage IToastMsg
@implements IDisposable

<DxGrid Data="@listMission" @bind-SelectedDataItem="@targetMission" AllowSelectRowByClick="true" SelectionMode="GridSelectionMode.Single" HighlightRowOnHover="true" AutoCollapseDetailRow="true" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer">
    <ToolbarTemplate>
        <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
            <DxToolbarItem IconCssClass="oi oi-plus" Click="_clickNewMission" />
            <DxToolbarItem IconCssClass="oi oi-media-stop" Enabled="@missionSelected" Click="_clickCancelMission" RenderStyle="ButtonRenderStyle.Danger"/>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridDataColumn FieldName="@nameof(AmrMissionTable.AmrSerialNumber)" Width="280px" />
        <DxGridDataColumn FieldName="@nameof(AmrMissionTable.Priority)" />
        <DxGridDataColumn FieldName="@nameof(AmrMissionTable.FlowCount)" />
        <DxGridDataColumn FieldName="@nameof(AmrMissionTable.EstablishTime)" DisplayFormat="g" />
        <DxGridDataColumn FieldName="@nameof(AmrMissionTable.StartTime)" DisplayFormat="g" />
        <DxGridDataColumn FieldName="@nameof(AmrMissionTable.ErrorCode)" />
        <DxGridDataColumn FieldName="@nameof(AmrMissionTable.ErrorMessage)" />
        <DxGridDataColumn FieldName="@nameof(AmrMissionTable.FinishTime)" DisplayFormat="g" />
        <DxGridDataColumn FieldName="@nameof(AmrMissionTable.CancelRequest)" />
        <DxGridDataColumn FieldName="@nameof(AmrMissionTable.CancelTime)" DisplayFormat="g" />
    </Columns>

    <DetailRowTemplate Context="Context">
        <MissionFlowsDetail Mission="@(Context.DataItem as AmrMissionTable)" />
    </DetailRowTemplate>
</DxGrid>

<PopupNewMission @ref="popUpNewMission" ListFlowType="listFlowType" ListAmrSerialNumber="listAmrSerialNumber" ListCellName="listCellName" CbOnSaved="_onNewMissionSaved" />

@code {
    List<AmrMissionTable> listMission { get; set; } = new List<AmrMissionTable>();

    PopupNewMission? popUpNewMission { get; set; } = null;

    Object? targetMission { get; set; } = null;
    bool missionSelected => targetMission != null;

    List<EFlowType> listFlowType { get; set; } = new List<EFlowType>();
    List<string> listAmrSerialNumber { get; set; } = new List<string>();
    List<string> listCellName { get; set; } = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        machineService.dgAmrMissionUpdate += _handleMissionUpdated;
        machineService.dgInitResult += _handleInitResult;
        await _loadMissionList();
    }

    async Task _loadMissionList()
    {
        listMission = await machineService.GetAmrMissionInQueue();

        listFlowType = new List<EFlowType>()
        {
            EFlowType.Move,
            EFlowType.Charge
        };

        listAmrSerialNumber = new List<string>()
        {
            "smr_9901010401002t73j251"
        };

        listCellName = new List<string>()
        {
            "departure",
            "destination",
            "Charger"
        };
    }

    async Task _clickNewMission()
    {
        if (popUpNewMission != null)
        {
            await popUpNewMission.ShowAsync();
        }
    }

    async Task _onNewMissionSaved(AmrMissionTable mission)
    {
        IToastMsg.NotifyInfo("Start Add Mission");

        if (await machineService.SetMission(mission))
        {
            await _loadMissionList();
            IToastMsg.NotifySuccess("Add New Mission Success");
        }
        else
        {
            IToastMsg.NotifyError("Add New Mission Fail");
        }
    }

    async Task _clickCancelMission()
    {
        IToastMsg.NotifyInfo("Start Cancel Mission");

        AmrMissionTable target = (AmrMissionTable)targetMission;

        if (target.IsFinish || target.CancelRequest || target.IsCancel)
        {
            IToastMsg.NotifyError("Cancel Mission Fail");
            return;
        }

        if (await machineService.CancelMission(target))
        {
            await _loadMissionList();
            IToastMsg.NotifySuccess("Cancel Mission Success");
        }
        else
        {
            IToastMsg.NotifyError("Cancel Mission Fail");
        }
    }

    async Task _handleMissionUpdated(List<AmrMissionTable> missions)
    {
        listMission = missions; 
        await InvokeAsync(StateHasChanged);
    }

    async Task _handleInitResult(bool success, string msg)
    {
        if (success)
        {
            IToastMsg.NotifySuccess(msg);
        }
        else
        {
            IToastMsg.NotifyError(msg);
        }
    }

    public void Dispose()
    {
        machineService.dgAmrMissionUpdate -= _handleMissionUpdated;
        machineService.dgInitResult -= _handleInitResult;
    }
}
