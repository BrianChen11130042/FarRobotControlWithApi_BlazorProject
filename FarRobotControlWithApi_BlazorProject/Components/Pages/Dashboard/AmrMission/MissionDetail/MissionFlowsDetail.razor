@using FarRobotControlWithApi_BlazorProject.Components.Pages.Dashboard.AmrMission
@using FarRobotControlWithApi_BlazorProject.Components.Pages.Dashboard.AmrMission.PrintFlow
@using FarRobotControlWithApi_BlazorProject.EFModel

<DxGrid Data="@Flows" PageSize="20" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer">
    <Columns>
        <DxGridDataColumn Caption="FlowType">
            <CellDisplayTemplate Context="TypeContext">
                @_getFlowType(TypeContext.DataItem)
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn Caption="Detail" Width="150px">
            <CellDisplayTemplate Context="DetailContext">
                <PrintFlowHost Flow="@(DetailContext.DataItem as FlowBase)" />
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="@nameof(FlowBase.EstablishTime)" DisplayFormat="g" />
        <DxGridDataColumn FieldName="@nameof(FlowBase.StartTime)" DisplayFormat="g" />
        <DxGridDataColumn FieldName="@nameof(FlowBase.StateString)" />
        <DxGridDataColumn FieldName="@nameof(FlowBase.CompletePercent)" />
        <DxGridDataColumn FieldName="@nameof(FlowBase.StatusCode)" />
        <DxGridDataColumn FieldName="@nameof(FlowBase.StatusMessage)" />
        <DxGridDataColumn FieldName="@nameof(FlowBase.FinishTime)" DisplayFormat="g" />
        <DxGridDataColumn FieldName="@nameof(FlowBase.CancelTime)" DisplayFormat="g" />
    </Columns>
</DxGrid>


@code {
    [Parameter]
    public AmrMissionTable? Mission { get; set; } = null;

    IEnumerable<FlowBase>? Flows => Mission?.Flows.OrderBy(x => x.EstablishTime).ThenBy(x => x.Id) ?? Enumerable.Empty<FlowBase>();

    string _getFlowType(object item)
    {
        switch (item)
        {
            case MoveFlowTable moveFlow:
                return EFlowType.Move.ToString();

            case ChargeFlowTable chargeFlow:
                return EFlowType.Charge.ToString();

            default:
                return "?";
        }
    }
}
